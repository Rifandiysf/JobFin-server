DATABASE_URL="mysql://user:password@localhost:3306/job_tracker"

JWT_SECRET="replace-with-a-long-random-secret-key"
JWT_EXPIRES_IN="7d"

PORT=5000
FRONTEND_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
EMAIL_FROM="Job Tracker <onboarding@resend.dev>"
RESET_PASSWORD_URL="http://localhost:3000/reset-password"

# Map services (free OpenStreetMap servers, no API key required).
# Required in production: identifies your app to Nominatim, as its usage policy demands.
MAP_USER_AGENT="JobFin/1.0 (contact: you@example.com)"

# Optional: point to another Nominatim/OSRM-compatible server without changing code.
NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
OSRM_URL="https://router.project-osrm.org/route/v1/driving"

# Optional: minimum gap in milliseconds between requests to the same service.
# Keep it at 1000 or more while using the public servers.
MAP_MIN_REQUEST_INTERVAL_MS=1100